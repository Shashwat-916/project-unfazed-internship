generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum UserRole {
    CLIENT
    THERAPIST
}

enum Status {
    ACTIVE
    INACTIVE
}

enum AppointmentStatus {
    PENDING
    CONFIRMED
    CANCELLED
    COMPLETED
}

enum PaymentStatus {
    PENDING
    SUCCESS
    FAILED
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum NoteType {
    PRIVATE
    SHARED
}

enum NoteFormat {
    FREEFORM
    SOAP
    DAP
}

model User {
    id       String  @id @default(uuid())
    email    String  @unique
    password String
    name     String
    verified Boolean @default(false)

    UserRole UserRole

    therapist Therapist?
    client    Client?

    messages     Message[]
    notification Notification[]
}

model Therapist {
    id          String @id @default(uuid())
    phoneNumber String

    slug           String   @unique
    specialization String[]
    bio            String[]
    profileImage   String?
    languages      String[]

    status Status? @default(INACTIVE)

    userId String @unique
    user   User   @relation(fields: [userId], references: [id])

    services      Service[]
    avalabilities Avalability[]
    appointments  Appointment[]
    conversations Conversation[]
    notes         SessionNote[]
}

model Client {
    id           String  @id @default(uuid())
    profileImage String?
    phoneNumber  String
    status       Status? @default(INACTIVE)

    userId String @unique
    user   User   @relation(fields: [userId], references: [id])

    appointments  Appointment[]
    conversations Conversation[]

    intake ClientIntake?
    notes  SessionNote[]
}

model Service {
    id           String  @id @default(uuid())
    name         String
    description  String? @db.Text
    duration     Int     @default(50)
    price        Int     @default(0)
    serviceImage String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    therapistId String
    therapist   Therapist @relation(fields: [therapistId], references: [id])

    appointments Appointment[]
}

model Avalability {
    id        String    @id @default(uuid())
    dayOfWeek DayOfWeek

    therapistId String
    therapist   Therapist @relation(fields: [therapistId], references: [id])

    timeSlotId Int
    timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id])

    @@unique([therapistId, dayOfWeek, timeSlotId])
}

model TimeSlot {
    id        Int      @id
    startTime DateTime @db.Time
    endTime   DateTime @db.Time

    availabilities Avalability[]
}

model Appointment {
    id String @id @default(uuid())

    therapistId String
    therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

    serviceId String
    service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

    startTime   DateTime
    endTime     DateTime
    totalAmount Int

    paymentStatus     PaymentStatus     @default(PENDING)
    appointmentStatus AppointmentStatus @default(PENDING)
    bookingTime       DateTime          @default(now())

    payment Payment?

    notes SessionNote[]

    @@index([therapistId, startTime])
}

model Payment {
    id               String  @id @default(uuid())
    gatewayOrderId   String  @unique
    gatewayPaymentId String? @unique
    gatewaySignature String?
    amount           Int

    status PaymentStatus @default(PENDING)

    appointmentId String      @unique
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Message {
    id      String @id @default(uuid())
    content String @db.Text

    senderId       String
    conversationId String

    user         User         @relation(fields: [senderId], references: [id])
    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
}

model Conversation {
    id String @id @default(uuid())

    clientId String
    client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

    therapistId String
    therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

    messages  Message[]
    createdAt DateTime  @default(now())
    updatedAt DateTime  @default(now()) @updatedAt
}

model Notification {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    content   String   @db.Text
    isRead    Boolean  @default(false)
    createdAt DateTime @default(now())

    @@index([userId])
}

model ClientIntake {
    id String @id @default(uuid())

    clientId String @unique
    client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

    dateOfBirth DateTime?
    gender      String?
    occupation  String?

    presentingConcern String? @db.Text
    currentSymptoms   String? @db.Text

    medicalHistory      String? @db.Text
    mentalHealthHistory String? @db.Text
    medicationHistory   String? @db.Text
    familyHistory       String? @db.Text
    previousTherapy     String? @db.Text

    goals          String? @db.Text
    additionalInfo Json?

    completedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

model SessionNote {
    id String @id @default(uuid())

    appointmentId String
    appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

    therapistId String
    therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

    clientId String
    client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

    type   NoteType   @default(PRIVATE)
    format NoteFormat @default(FREEFORM)

    // FREEFORM
    content String? @db.Text

    // SOAP
    subjective String? @db.Text
    objective  String? @db.Text
    assessment String? @db.Text
    plan       String? @db.Text

    // DAP
    data         String? @db.Text
    intervention String? @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([appointmentId])
    @@index([clientId])
    @@index([therapistId])
}
