# ================================
# Stage 1: Prune workspace
# ================================
FROM oven/bun:1-alpine AS pruner

WORKDIR /app

COPY . .

RUN bunx turbo prune webrtc --docker


# ================================
# Stage 2: Install dependencies
# ================================
FROM oven/bun:1-alpine AS installer

WORKDIR /app

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/bun.lock ./bun.lock

RUN bun install --frozen-lockfile


# ================================
# Stage 3: Build WebRTC service
# ================================
FROM oven/bun:1-alpine AS builder

WORKDIR /app

COPY --from=installer /app/ .

COPY --from=pruner /app/out/full/ .

RUN bunx turbo run build --filter=webrtc


# ================================
# Stage 4: Production runner
# ================================
FROM oven/bun:1-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Production dependencies
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/bun.lock ./bun.lock

RUN bun install --frozen-lockfile --production

# Copy compiled WebRTC service
COPY --from=builder /app/apps/webrtc/dist ./apps/webrtc/dist

WORKDIR /app/apps/webrtc

EXPOSE 8081

CMD ["bun", "run", "dist/index.js"]